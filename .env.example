# Настройки для docker compose (cp .env.example .env)

# Обязательно: openssl rand -hex 32
JWT_SECRET=

# Адрес, по которому открываете приложение
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# OAuth — необязательно. Redirect URI:
#   Google: http://localhost:3000/api/auth/oauth/google/callback
#   GitHub: http://localhost:3000/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Telegram-уведомления — необязательно. Токен бота у @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
