# Локальный запуск API: cp .env.example .env && make run
# (PostgreSQL поднимается командой: make infra)

HTTP_ADDR=:8080
DATABASE_URL=postgres://issuetracker:issuetracker@localhost:5432/issuetracker?sslmode=disable
MIGRATE_ON_START=true

# Секрет для подписи JWT — не короче 32 символов: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# true на HTTPS (прод)
COOKIE_SECURE=false

# Фронтенд (Vite dev server) — сюда редиректим после входа через Google/GitHub
APP_URL=http://localhost:5173
# Адрес API снаружи: из него строятся redirect_uri для OAuth
API_PUBLIC_URL=http://localhost:5173/api
ALLOWED_ORIGINS=http://localhost:5173

# Хранилище файлов: local — папка на диске (по умолчанию), s3 — S3/MinIO
STORAGE_DRIVER=local
STORAGE_DIR=./uploads

# Нужны только при STORAGE_DRIVER=s3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=issuetracker
S3_REGION=us-east-1
S3_USE_SSL=false

# OAuth (пусто — кнопка покажет «не настроено»). Как получить — в README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Telegram-уведомления (необязательно): токен у @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Имя бота подставится само (getMe); можно задать вручную, если api.telegram.org недоступен при старте
TELEGRAM_BOT_USERNAME=
